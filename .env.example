# ============================================================================
# AEGISPAY OS — ENVIRONMENT CONFIGURATION (.env)
# ============================================================================

# 1. Google OAuth 2.0 Authentication (From https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Leave blank to auto-detect localhost:8787 vs your Vercel domain automatically
GOOGLE_REDIRECT_URI=

# 2. PayPal Developer Sandbox REST API v2 (From https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# 3. Primary & Secondary AI Failover Mesh + Neural Prompt Guard
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# 4. Cryptographic Signing & Outbound Escalation
# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for stable sessions across deployments; never use a shared example value.
AEGIS_KERNEL_SECRET=
# Optional isolated practice mode with fixture data. Keep disabled for provider verification.
ALLOW_DEMO_SANDBOX=false
ZAPIER_WEBHOOK_URL=
PORT=8787
