{
  "info": {
    "_postman_id": "5b615dc9-3d79-4190-92ba-681ca768d3da",
    "name": "AegisPay sandbox integration checks",
    "description": "Use a private Postman environment for accountPassword. Set sandbox merchant/buyer identities. Run checkout requests individually; approve with a separate sandbox personal buyer before capture. No embedded shared credentials. Do not run against production money. Review and signing token expire; repeat review when needed. Benchmarks and safety fuzzers use synthetic TEST inputs only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8787"
    },
    {
      "key": "accountEmail",
      "value": ""
    },
    {
      "key": "sandboxMerchantEmail",
      "value": ""
    },
    {
      "key": "sandboxBuyerEmail",
      "value": ""
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "signedToken",
      "value": ""
    },
    {
      "key": "paypalOrderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health and actual provider configuration",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Sign in with your account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "AegisPay-Client"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"{{accountPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Sign-in succeeded\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"authToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Tenant workspace",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/state"
      }
    },
    {
      "name": "Review payment request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "AegisPay-Client"
          }
        ],
        "url": "{{baseUrl}}/api/scamshield/review",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rawText\": \"Invoice for completed design work: $1.00 USD via PayPal Goods and Services.\",\n  \"claimedAmountCents\": 100,\n  \"currency\": \"USD\",\n  \"payeeIdentifier\": \"{{sandboxMerchantEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Review succeeded\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "if(data.signedToken) pm.collectionVariables.set(\"signedToken\", JSON.stringify(data.signedToken));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create reviewed PayPal sandbox order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "AegisPay-Client"
          }
        ],
        "url": "{{baseUrl}}/api/scamshield/create-paypal-order",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"signedToken\": {{signedToken}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Order creation succeeded\", () => pm.response.to.have.status(200));",
              "if(pm.response.code===200) pm.collectionVariables.set(\"paypalOrderId\",pm.response.json().orderId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Capture AFTER sandbox buyer approval",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "AegisPay-Client"
          }
        ],
        "url": "{{baseUrl}}/api/scamshield/capture-paypal-order",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{paypalOrderId}}\",\n  \"signedToken\": {{signedToken}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "HTTP MCP initialize",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "AegisPay-Client"
          }
        ],
        "url": "{{baseUrl}}/api/mcp",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "HTTP MCP list tools",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "AegisPay-Client"
          }
        ],
        "url": "{{baseUrl}}/api/mcp",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/list\",\n  \"params\": {}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "HTTP MCP authenticated cashflow query",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "AegisPay-Client"
          }
        ],
        "url": "{{baseUrl}}/api/mcp",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 3,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"aegispay_check_cashflow\",\n    \"arguments\": {\n      \"itemTitle\": \"Proposed purchase\",\n      \"proposedSpendCents\": 100\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create milestone plan (does not send invoice)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "AegisPay-Client"
          }
        ],
        "url": "{{baseUrl}}/api/paystream/create-plan",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"projectTitle\": \"Sandbox design project\",\n  \"projectBrief\": \"Plan three milestones: discovery, implementation, and acceptance.\",\n  \"clientEmail\": \"{{sandboxBuyerEmail}}\",\n  \"totalBudgetCents\": 10001\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Read-only subscription discovery",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "AegisPay-Client"
          }
        ],
        "url": "{{baseUrl}}/api/lupa/subscriptions/sync-paypal",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Synthetic safety verifier (test fixtures only)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "AegisPay-Client"
          }
        ],
        "url": "{{baseUrl}}/api/security/fuzz",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"iterations\": 1000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Sign out",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "AegisPay-Client"
          }
        ],
        "url": "{{baseUrl}}/api/auth/logout",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
