{
  "manifest_version": 3,
  "name": "AegisPay Agentic Firewall & PayPal Guard",
  "version": "3.2.0",
  "description": "1-click webpage scanner, invoice & link safety firewall, subscription detector, and verified PayPal checkout companion.",
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "https://aegispay-orpin.vercel.app/*"
  ],
  "action": {
    "default_title": "Open AegisPay Agentic Side Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
